#!/bin/bash
# =============================================================================
# postinstall — runs after the .pkg copies files to the staging area.
#
# This is the bridge between the macOS .pkg GUI and the bash installer.
# The .pkg copies the installer files to /tmp/falconpulsar-installer,
# then this script runs install.sh with the user's environment.
#
# Note: postinstall runs as root (Apple Installer requirement).
# We drop privileges to the actual user before running install.sh.
# =============================================================================

set -e

INSTALL_DIR="/tmp/falconpulsar-installer"
LOG_FILE="/tmp/falconpulsar-install.log"

# Initialize the log file
cat > "$LOG_FILE" <<LOGHEADER
================================================================
  FalconPulsar macOS Installer Log
  Version: 0.1.0
  Date: $(date '+%Y-%m-%d %H:%M:%S')
================================================================

LOGHEADER

log_info() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [info] $1" >> "$LOG_FILE"; }
log_error() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [error] $1" >> "$LOG_FILE"; }

log_info "Postinstall starting"
log_info "macOS: $(sw_vers -productVersion)"
log_info "Architecture: $(uname -m)"
log_info "User: $(whoami) (running as root via .pkg)"

# Detect the real user who launched the installer
REAL_USER="${SUDO_USER:-${USER}}"
if [ "$REAL_USER" = "root" ]; then
    REAL_USER=$(stat -f '%Su' /dev/console 2>/dev/null || echo "$USER")
fi
log_info "Actual user: $REAL_USER"
log_info "Home: $(eval echo ~$REAL_USER)"

# Verify installer files exist
if [ ! -f "$INSTALL_DIR/macos/install.sh" ]; then
    log_error "install.sh not found at $INSTALL_DIR/macos/install.sh"
    exit 1
fi

# Make scripts executable
chmod +x "$INSTALL_DIR/macos/install.sh"
chmod +x "$INSTALL_DIR/macos/uninstall.sh"
chmod +x "$INSTALL_DIR/shared/lib/"*.sh

# Check if Docker is available before running the installer.
# sudo -u runs a non-login shell with minimal PATH, so we must
# either use -i (login shell) or check known paths explicitly.
log_info "Checking container runtime..."

# Check known Docker install locations
DOCKER_PATH=""
for candidate in \
    /usr/local/bin/docker \
    /opt/homebrew/bin/docker \
    /Applications/Docker.app/Contents/Resources/bin/docker \
    "$(eval echo ~$REAL_USER)/.docker/bin/docker" \
    "$(eval echo ~$REAL_USER)/.orbstack/bin/docker"; do
    if [ -x "$candidate" ]; then
        DOCKER_PATH="$candidate"
        break
    fi
done

# Fallback: try the user's login shell PATH
if [ -z "$DOCKER_PATH" ]; then
    DOCKER_PATH=$(sudo -u "$REAL_USER" -i bash -c 'which docker 2>/dev/null || echo ""')
fi

if [ -z "$DOCKER_PATH" ]; then
    log_error "Docker not found for user $REAL_USER"
    log_error "Checked: /usr/local/bin, /opt/homebrew/bin, Docker.app, .orbstack"
    log_error "Install Docker Desktop, Colima, OrbStack, or Rancher Desktop first"
    echo "Docker is not installed. Please install Docker Desktop (or Colima/OrbStack/Rancher Desktop) and run the installer again." > /tmp/falconpulsar-install-error.txt
    exit 1
fi
log_info "Found Docker at: $DOCKER_PATH"

# Docker commands must run as the actual user (not root) because
# Docker Desktop's socket is user-specific.
DOCKER_RUNNING=$(sudo -u "$REAL_USER" "$DOCKER_PATH" info >/dev/null 2>&1 && echo yes || echo no)
if [ "$DOCKER_RUNNING" = "no" ]; then
    log_error "Docker is installed but not running"
    log_info "Attempting to wait for Docker to start (30 seconds)..."
    for i in 1 2 3 4 5 6; do
        sleep 5
        DOCKER_RUNNING=$(sudo -u "$REAL_USER" "$DOCKER_PATH" info >/dev/null 2>&1 && echo yes || echo no)
        if [ "$DOCKER_RUNNING" = "yes" ]; then
            log_info "Docker is now running (waited $((i * 5))s)"
            break
        fi
        log_info "Docker not ready yet (attempt $i/6)..."
    done
    if [ "$DOCKER_RUNNING" = "no" ]; then
        log_error "Docker is not running after 30 seconds"
        echo "Docker is installed but not running. Please start Docker Desktop and run the installer again." > /tmp/falconpulsar-install-error.txt
        exit 1
    fi
fi
log_info "Docker is available and running"

# Run the macOS installer as the actual user
log_info "Running install.sh as $REAL_USER"
cd "$INSTALL_DIR"
sudo -u "$REAL_USER" -i \
    FP_ASSUME_YES=1 \
    FP_LEGAL_ACCEPTED=1 \
    bash "$INSTALL_DIR/macos/install.sh" --yes 2>&1 | tee -a "$LOG_FILE"

EXIT_CODE=${PIPESTATUS[0]}

if [ "$EXIT_CODE" -eq 0 ]; then
    log_info "Installation completed successfully"
    log_info "Web UI: http://localhost:8080"
    log_info "Log file: $LOG_FILE"
else
    log_error "Installation failed with exit code $EXIT_CODE"
fi

# Clean up the staging area
rm -rf "$INSTALL_DIR"

exit "$EXIT_CODE"
