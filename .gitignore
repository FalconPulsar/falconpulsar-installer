# Local-only environment files (the installer GENERATES these on the
# user's host; they should never be checked in to source control)
.env
.env.local
.env.*

# Inno Setup compiled output (built by CI on Windows runners)
windows/Output/
*.exe

# Generated wizard images (built from windows/assets/falcon-logo.png by
# windows/scripts/build-assets.ps1 — see windows/README-windows-build.md)
windows/assets/header.bmp
windows/assets/welcome.bmp
windows/assets/falcon.ico

# .NET build output for the Windows tray app.
#
# These were TRACKED until now -- 24 files of stale Debug artifacts (DLLs,
# PDBs, MSBuild caches, generated AssemblyInfo.cs). Nothing consumed them:
# installer.iss:164 packages "tray-app\publish\FalconPulsarTray.exe", which
# release.yml produces with `dotnet publish -o windows/tray-app/publish`
# from source. They only dirtied the working tree of anyone who ran a local
# build, and invited a stale binary into a diff.
#
# Scoped to this project rather than a bare `bin/` / `obj/` so nothing else
# in the repo can be swept up by accident -- Go's console/internal/ is meant
# to ship, and a repo-wide rule is one rename away from hiding real source.
windows/tray-app/bin/
windows/tray-app/obj/
# The publish dir CI writes the tray into. The *.exe rule above covers the
# binary itself; this covers the .dll/.json that land beside it.
windows/tray-app/publish/

# macOS build output
macos/pkg/output/
macos/pkg/staging/
macos/installer-app/.build/
macos/menu-bar-app/.build/
dist/

# Local test artifacts
*.log
test-output/
.cache/

# OS noise
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# AI-assistant context (always local-only — see CLAUDE.md convention)
.claude/
CLAUDE.md
**/CLAUDE.md

# Python (in case anyone adds helper scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Internal dev-only tools (root only — Go's console/internal/ is meant to ship)
/internal/

# ── AI assistant: local session files & context (never commit) ──
# Cursor / SpecStory — per-chat transcripts saved into the repo
.specstory/
# Cursor — local editor/project state (shared project rules stay tracked)
.cursor/*
!.cursor/rules/
# Grok CLI (xAI) — in-project data: generated media, session traces, config
.grok/
.grok-cli/
