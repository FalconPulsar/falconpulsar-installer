# =============================================================================
# FalconPulsar — systemd user unit (template)
# =============================================================================
#
# Installed by linux/install.sh into:
#   /home/falconpulsar/.config/systemd/user/falconpulsar.service
#
# The installer substitutes @@FP_HOME@@ with the actual home directory before
# writing the file. Loginctl linger is enabled so the unit starts at boot
# without requiring an active login session.
#
# Manage with (as root or as the falconpulsar user with the right
# XDG_RUNTIME_DIR):
#
#   systemctl --user start    falconpulsar
#   systemctl --user stop     falconpulsar
#   systemctl --user restart  falconpulsar
#   systemctl --user status   falconpulsar
#   journalctl --user -u falconpulsar -f
# =============================================================================

[Unit]
Description=FalconPulsar time-series database stack
Documentation=https://github.com/FalconPulsar/falconpulsar-installer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@@FP_HOME@@
# fp resolves the stack directory from FP_HOME first, then falls back to
# ~/falconpulsar or /home/falconpulsar. Setting FP_HOME explicitly is
# defensive: it makes the unit work regardless of the resolution order
# and means the unit file is the single source of truth for "where is
# the stack on this host".
Environment=FP_HOME=@@FP_HOME@@

# Delegate to the fp CLI rather than calling `docker compose` directly.
# fp reads .env's FP_AI_GATEWAY_ENABLED and automatically appends
# `--profile ai` when needed (see actions.go:composeProfileArgs). Without
# this indirection every systemctl restart silently dropped the AI
# gateway container because the bare `docker compose` doesn't activate
# the "ai" profile. The fp binary lives in @@FP_HOME@@/bin/fp; it is
# installed by linux/install.sh's step 7 well before this unit is
# enabled, so the path is always populated by the time systemd runs it.
ExecStart=@@FP_HOME@@/bin/fp start
ExecStop=@@FP_HOME@@/bin/fp stop
ExecReload=@@FP_HOME@@/bin/fp restart

TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
